<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:background="#0A1120"
    android:orientation="vertical">

    <!-- Top Navigation & Action Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#141E33"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Synqvia"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ime_header_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Clipboard"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Switch Keyboard Button -->
        <ImageButton
            android:id="@+id/btn_switch_keyboard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ime_header_button"
            android:contentDescription="@string/ime_switch_keyboard"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ime_keyboard" />

        <!-- Close / Hide IME Button -->
        <ImageButton
            android:id="@+id/btn_close_ime"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ime_header_button"
            android:contentDescription="Close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ime_close" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#203354" />

    <!-- Content Area: RecyclerView or Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ime_clips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_ime_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ime_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ime_no_clips"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Copied text appears here automatically. Tap switch keyboard to return to your normal keyboard."
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
