<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_ime_clipboard_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ime_background">

    <!-- Content Area: RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ime_clips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layout_ime_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ime_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ime_no_clips"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:fontFamily="@font/inter_variable"
            android:fontVariationSettings="'wght' 600, 'opsz' 14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Copied text appears here automatically."
            android:textColor="#7A8CAB"
            android:textSize="11sp"
            android:fontFamily="@font/inter_variable"
            android:fontVariationSettings="'wght' 400, 'opsz' 14" />

    </LinearLayout>

</FrameLayout>
