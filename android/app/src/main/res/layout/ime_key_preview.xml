<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/ime_preview_bubble_width"
    android:layout_height="@dimen/ime_preview_bubble_height"
    android:background="@drawable/bg_ime_preview_bubble">

    <TextView
        android:id="@+id/tv_preview_char"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/ime_key_text"
        android:textSize="22sp"
        android:fontFamily="@font/inter_variable"
        android:fontVariationSettings="'wght' 400, 'opsz' 22" />
</FrameLayout>
