<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_ime_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Metadata Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_clip_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2200E5FF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Local"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_clip_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Just now"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Pin Button -->
        <ImageView
            android:id="@+id/btn_pin_clip"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_pinned"
            android:padding="4dp"
            android:src="@drawable/ic_ime_pin" />

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/btn_delete_clip"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_delete"
            android:padding="5dp"
            android:src="@drawable/ic_ime_delete" />

    </LinearLayout>

    <!-- Clip Text Preview -->
    <TextView
        android:id="@+id/tv_clip_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
